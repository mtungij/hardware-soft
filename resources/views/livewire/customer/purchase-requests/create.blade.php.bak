                    class="min-h-11 shrink-0 rounded-xl px-4 py-2 text-sm font-black transition
                        {{ $alreadyAdded ? 'bg-green-100 text-green-700 cursor-default dark:bg-green-900/30 dark:text-green-300' : 'bg-build-orange text-white hover:opacity-90' }}">
